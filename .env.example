# Copy this file to `.env.local` and replace the placeholder values.

# Optional public app URL for callbacks or self-referential links.
APP_URL="https://whatsapp.shivammadaan.com"
# Same-origin API routing is the default. Keep API_URL aligned with APP_URL unless
# the server is intentionally deployed on a separate origin.
API_URL="https://whatsapp.shivammadaan.com"
VITE_API_URL=""

# WhatsApp webhook verification
META_VERIFY_TOKEN="set_the_same_verify_token_used_in_meta_webhooks"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="set_the_same_verify_token_used_in_meta_webhooks"

# Facebook Embedded Signup
FACEBOOK_APP_ID="your_meta_app_id_here"
VITE_FACEBOOK_APP_ID="your_meta_app_id_here"
VITE_FACEBOOK_CONFIG_ID="685359038005430"
FACEBOOK_APP_SECRET="your_meta_app_secret_here"

META_GRAPH_VERSION="v25.0"

# Optional Firebase Admin credential for webhook-side Firestore access
# Use FIREBASE_SERVICE_ACCOUNT_PATH only for local files on your machine.
# On Render, leave the path empty and set FIREBASE_SERVICE_ACCOUNT_JSON instead.
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
